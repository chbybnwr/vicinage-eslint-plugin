{
  "name": "@vicinage/eslint-plugin",
  "version": "0.5.5",
  "description": "Vicinage eslint plugin.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chbybnwr/vicinage-eslint-plugin.git"
  },
  "homepage": "https://github.com/chbybnwr/vicinage-eslint-plugin",
  "bugs": {
    "url": "https://github.com/chbybnwr/vicinage-eslint-plugin/issues"
  },
  "funding": "https://github.com/sponsors/chbybnwr",
  "keywords": [
    "vicinage",
    "eslint",
    "plugin"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "check": "run-s \"test -- --coverage --reporter=verbose\" lint \"format -- --check\" spellcheck",
    "prepack": "shx cp package.json package.json.backup && npm pkg delete scripts packageManager devDependencies",
    "postpack": "shx rm package.json && shx mv package.json.backup package.json",
    "build": "tsdown",
    "compile": "tsc --project tsconfig.build.json",
    "extract": "shx rm -rf ./lib/ && npm run compile && api-extractor run --local",
    "test": "vitest run",
    "lint": "eslint ./ --cache",
    "format": "prettier ./",
    "spellcheck": "cspell ./",
    "local-pack": "run-s build && npm pack"
  },
  "packageManager": "pnpm@11.1.1",
  "dependencies": {
    "@csstools/css-tokenizer": "^3.0.3",
    "@stylexjs/shared": "~0.18.3",
    "micromatch": "^4.0.5",
    "postcss-value-parser": "^4.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^1.2.0",
    "@eslint/markdown": "^8.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@txe/eslint-plugin-x": "~0.2.1",
    "@txe/tsconfig": "file:modules/txe-tsconfig-0.1.0.tgz",
    "@types/estree": "^1.0.8",
    "@types/node": "^25.6.0",
    "@typescript-eslint/parser": "^8.59.1",
    "@typescript/native-preview": "7.0.0-dev.20260422.1",
    "@vitest/coverage-v8": "^4.1.5",
    "@vitest/eslint-plugin": "^1.6.16",
    "cspell": "^10.0.0",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-n": "^17.24.0",
    "eslint-plugin-unicorn": "^64.0.0",
    "globals": "^17.5.0",
    "npm-run-all2": "^8.0.4",
    "prettier": "^3.8.3",
    "shx": "~0.4.0",
    "tsdown": "~0.21.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.1",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  }
}
