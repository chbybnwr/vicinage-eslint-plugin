{
  "name": "@vicinage/eslint-plugin",
  "version": "0.6.9",
  "description": "Vicinage eslint plugin.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chbybnwr/vicinage-eslint-plugin.git"
  },
  "homepage": "https://github.com/chbybnwr/vicinage-eslint-plugin",
  "bugs": {
    "url": "https://github.com/chbybnwr/vicinage-eslint-plugin/issues"
  },
  "funding": "https://github.com/sponsors/chbybnwr",
  "keywords": [
    "vicinage",
    "eslint",
    "plugin"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "prepublishOnly": "npm run build && npm run extract && npm pkg delete scripts packageManager devDependencies",
    "check": "npm run test -- --coverage && npm run lint && npm run format -- --check && npm run spellcheck",
    "build": "tsdown",
    "compile": "tsc --project tsconfig.build.json",
    "extract": "npm run compile && api-extractor run",
    "extract:local": "npm run extract -- --local",
    "test": "vitest run",
    "lint": "eslint ./",
    "format": "prettier ./",
    "spellcheck": "cspell ./"
  },
  "packageManager": "pnpm@11.1.1",
  "dependencies": {
    "@csstools/css-tokenizer": "^3.0.4",
    "@stylexjs/shared": "~0.18.3",
    "micromatch": "^4.0.8",
    "postcss-value-parser": "^4.2.0"
  },
  "devDependencies": {
    "@chbybnwr/tsconfig": "github:chbybnwr/tsconfig#v0.1.1",
    "@eslint/config-helpers": "^0.6.0",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^1.2.0",
    "@eslint/markdown": "^8.0.1",
    "@microsoft/api-extractor": "^7.58.7",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@txe/eslint-plugin-x": "~0.2.1",
    "@types/estree": "^1.0.9",
    "@types/micromatch": "^4.0.10",
    "@types/node": "^25.9.0",
    "@typescript-eslint/parser": "^8.59.3",
    "@typescript/native-preview": "7.0.0-dev.20260422.1",
    "@vitest/coverage-v8": "^4.1.6",
    "@vitest/eslint-plugin": "^1.6.17",
    "cspell": "^10.0.0",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-n": "^17.24.0",
    "eslint-plugin-unicorn": "^64.0.0",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "tsdown": "~0.22.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.3",
    "vitest": "^4.1.6"
  }
}
